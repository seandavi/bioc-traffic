[Unit]
Description=Dashboard rollups, minute tier -> Parquet + JSON, then R2 (bioc-traffic#10)
After=network-online.target
Wants=network-online.target
OnFailure=bioc-notify@%N.service

[Service]
# DuckDB opens every Parquet file in the glob; the user-manager default soft limit is 1024 (1653 files by 2026-10-13)
LimitNOFILE=65536
Type=oneshot
WorkingDirectory=/home/davsean/Documents/git/bioc-traffic
# just, duckdb, gcloud, rclone
Environment=PATH=/home/davsean/.local/bin:/usr/bin:/bin
ExecStart=/home/davsean/.local/bin/just rollup minute
ExecStart=/home/davsean/.local/bin/just rollup-upload
# ~3 s. Stop before the next 15-min run is due.
TimeoutStartSec=14m
Nice=10
