[Unit]
Description=Package download stats, both eras -> Parquet + /packages/stats/ tree, then R2 (bioc-traffic#11)
After=network-online.target
Wants=network-online.target
OnFailure=bioc-notify@%N.service

[Service]
# DuckDB opens every Parquet file in the glob; the user-manager default soft limit is 1024 (1653 files by 2026-10-13)
LimitNOFILE=65536
Type=oneshot
WorkingDirectory=/home/davsean/Documents/git/bioc-traffic
# just, rclone
Environment=PATH=/home/davsean/.local/bin:/usr/bin:/bin
ExecStart=/home/davsean/.local/bin/uv run --script /home/davsean/Documents/git/bioc-traffic/download-stats.py
# Then the .tab files the Worker serves (bioc-infrastructure#114). A failed upload fails the unit.
ExecStart=/home/davsean/.local/bin/just stats-upload
# Stale months (the current one, ~1-4 min) plus aggregates and the tree (~28 min),
# measured 2026-09-30 on a busy onclappc02.
TimeoutStartSec=3h
Nice=10
