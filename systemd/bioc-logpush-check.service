[Unit]
Description=Alert if yesterday's Logpush access-log delivery to GCS is missing
Documentation=https://seandavi.github.io/bioc-infrastructure/adr/0003-request-logging-after-the-cloudflare-cutover.html
After=network-online.target
Wants=network-online.target
OnFailure=bioc-notify@%N.service

[Service]
Type=oneshot
WorkingDirectory=/home/davsean/Documents/git/bioc-traffic
ExecStart=/home/davsean/Documents/git/bioc-traffic/check-logpush.sh
# One GCS listing; anything past a few minutes is a stuck network call.
TimeoutStartSec=10m

[Install]
WantedBy=default.target
